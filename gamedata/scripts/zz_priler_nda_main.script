-- NDA (NPCs Die in Anomalies) by Priler
-- original idea/mod by AllC0r3

-- NDA tries to make this work by introducing a complex pathfinding restrictions,
-- damage formula system, NPCs protection (armor based as well), rolls (hello DnD),
-- and much, much more.
--
-- BETA WIP


-- [ Local Aliases ]--

local pairs = pairs
local ipairs = ipairs
local type = type
local tostring = tostring
local tonumber = tonumber
local sf = string.find
local sformat = string.format
local tinsert = table.insert
local tconcat = table.concat
local mfloor = math.floor
local mmax = math.max
local mmin = math.min
local mrand = math.random
local mceil = math.ceil


-- [ Module Variables ]--

local anomaly_cache = {}
local cache_valid = false
local cache_level = nil
local cache_built_at = 0   -- time_global() of last rebuild; drives the staleness refresh

local UPDATE_INTERVAL_SEC = 2.0

local cached_debug_mode = false
local cached_verbose_debug = false
local cached_mod_enabled = true
local cached_show_debug_anomalies = false

local debug_anomalies_shown = false

-- Optional state tracking for each NPC.
-- Created on first access and deleted during net_destroy.
-- Fields:
--   detection/memory: last_anomaly, known_anomalies, last_safe_time
--   restriction routing: restrictions, restrict_start, restrict_anchor_pos, avoid_since
--   push-through: push_through, push_through_single, push_anchor_pos, push_anchor_time, pre_push_run
--   feel/probe: feel_on, probed, probe_until, took_damage
local npc_state = {}

local ANOMALY_ATTRIBUTION_TIMEOUT = 5000

-- Max concurrent anomaly restrictions per NPC. Keep this high. The cap is a ceiling, not a
-- crash guard -- MIN_RESTRICT_DISTANCE prevents enclosure by always leaving the NPC an
-- accessible pocket, regardless of count. A low cap mainly causes harm: when more anomalies
-- are in range than it allows, the kept subset shuffles as the NPC moves, re-applying
-- restrictions every tick and producing a path-rebuild jerk.
local MAX_RESTRICTIONS_PER_NPC = 30

-- Distance threshold in meters for considering an NPC inside an anomaly.
-- At this range:
-- 1. Routing around is useless, so it is ignored as a new detection.
-- 2. The standard push-through path handles the escape instead.
local MIN_RESTRICT_DISTANCE = 4

-- Minimum net distance in meters an NPC must move to register progress during avoidance.
-- Key details:
-- 1. Measured by straight line displacement, not total path length.
-- 2. Prevents infinite circling by ensuring lack of real movement triggers the stuck timer.
local STUCK_PROGRESS_DIST = 8

-- Hard ceiling on continuous avoidance, as a multiple of npc_stuck_timeout
local STUCK_HARD_MULT = 2

-- Seconds to hold FEEL off before setting squad.rush_to_target on a push_through commit.
-- Lets an in-flight bolt-throw animation finish so its CMissile leaves the hand HudItem
-- slot before the movement transition, avoiding the CKinematics skeleton-mutex deadlock.
local FEEL_TO_RUSH_DELAY = 1.5

-- Spacing (meters) for the feeler election: a would-be feeler defers if a lower-id stalker is
-- this close, so two bolt-throw renders don't contest the CKinematics skeleton/IK locks. Also
-- the radius for push-through admission (a commit is denied if another squad is pushing within
-- it). Caps simultaneous bolt-throwers regardless of the engine-side mutex fix.
local SQUAD_CONTENTION_RADIUS = 10

local pcall_failures_seen = {}


-- [ Safe Wrappers ]--

local function safe_call(func, ...)
    local ok, result = pcall(func, ...)
    if ok then return result end

    local info = debug.getinfo(2, "Sl")
    local where = info and (info.short_src .. ":" .. info.currentline) or "unknown"
    local key = where .. "|" .. tostring(result)

    if not pcall_failures_seen[key] then
        pcall_failures_seen[key] = 1
        printf("[NDA][PCALL_FAIL] %s - %s (further occurrences silenced)", where, tostring(result))
    else
        pcall_failures_seen[key] = pcall_failures_seen[key] + 1
    end

    return nil
end

local function is_valid_object(obj)
    if not obj then return false end
    if type(obj.id) ~= "function" then return false end
    local id = safe_call(obj.id, obj)
    if not id or id == 65535 then return false end
    return true
end

local function is_valid_stalker(obj)
    if not is_valid_object(obj) then return false end
    local is_stalker = safe_call(IsStalker, obj)
    if not is_stalker then return false end
    local alive = safe_call(obj.alive, obj)
    return alive == true
end

local function get_position_copy(obj)
    if not is_valid_object(obj) then return nil end
    local pos = safe_call(obj.position, obj)
    if not pos then return nil end
    return vector():set(pos.x, pos.y, pos.z)
end


-- [ MCM Integration ]--

local function get_mcm_setting(key, default)
    if zz_priler_nda_mcm then
        local getter = zz_priler_nda_mcm["get_config"]
        if getter then
            local val = getter(key)
            if val ~= nil then return val end
        end
    end
    return default
end

local function is_mod_enabled() return cached_mod_enabled end
function is_debug_enabled() return cached_debug_mode end
local function is_verbose_debug() return cached_verbose_debug end
local function should_show_debug_anomalies() return cached_show_debug_anomalies end

local function update_mcm_cache()
    cached_mod_enabled = get_mcm_setting("mod_enabled", true)
    cached_debug_mode = get_mcm_setting("debug_mode", false)
    cached_verbose_debug = get_mcm_setting("verbose_debug", false)
    cached_show_debug_anomalies = get_mcm_setting("show_debug_anomalies", false)
end


-- [ Debug Logging ]--

local function dbg_log(category, format, ...)
    if not is_debug_enabled() then return end
    local msg = sformat(format, ...)
    printf("[%s][NDA][%s] %s", time_global(), category, msg)
end

local function dbg_verbose(category, format, ...)
    if not is_verbose_debug() then return end
    local msg = sformat(format, ...)
    printf("[%s][NDA][%s] %s", time_global(), category, msg)
end

-- Always-on diagnostic logging. The engine's printf only substitutes %s, so the
-- message is built with sformat first (which supports %d/%.1f) then passed as %s.
local function diag_log(category, format, ...)
    printf("[%s][NDA][%s] %s", time_global(), category, sformat(format, ...))
end


-- [ Anomaly Zone State ]--

-- Engine truth for whether a zone is currently switched on. Arrival (drx_da) and
-- the base Dynamic Anomalies feature both turn zones off through the same engine
-- path (disable_anomaly then ZoneDisable), so this one getter covers both with no
-- mod-specific code
local engine_zone_state_supported = nil

local function is_anomaly_zone_enabled(anom_obj)
    local enabled = safe_call(anom_obj.is_enabled_anomaly, anom_obj)
    if engine_zone_state_supported == nil then
        engine_zone_state_supported = (enabled ~= nil)
        dbg_log("INIT", "engine zone-state getter is_enabled_anomaly: %s",
            engine_zone_state_supported and "supported" or "unsupported, assuming all zones active")
    end
    if enabled == nil then return true end
    return enabled
end

-- OK SO.
-- Base game anomaly fields can spawn with restrictor_type = 2 (eDefaultRestrictorTypeIn).
-- The engine registers every such zone into its GLOBAL m_default_in_restrictions list, so
-- EVERY stalker auto-avoids it via the space_restriction_manager
-- kind of a WALL that stalkers should avoid (for whatever reason)
-- it ignores ai_die_in_anomaly (0) + NDA's push-through cannot clear (push-through only drops NDA's own add_restrictions + feel flag)
--
-- The cordon railway tunnel is lined floor-to-floor with such witches_galantine zones, so
-- NPCs park at the mouth and never cross.
-- To "fix" this, we force em to type 3 (eRestrictorTypeNone) so NDA
-- alone governs avoidance/damage. force_set_restrictor_type UNREGISTERS the old type first
-- (script_game_object3.cpp:2051); plain set_restrictor_type does not, so it cannot remove an
-- existing default registration. Player anomaly damage is unaffected (separate feel/Affect
-- path)
local DEFAULT_AVOID_RESTR = 2  -- eDefaultRestrictorTypeIn (global auto-avoid)
local NONE_RESTR          = 3  -- eRestrictorTypeNone (unregistered, no auto-avoid)
local function neutralize_default_avoid(anom_obj)
    if type(anom_obj.get_restrictor_type) ~= "function"
       or type(anom_obj.force_set_restrictor_type) ~= "function" then
        return
    end
    if safe_call(anom_obj.get_restrictor_type, anom_obj) == DEFAULT_AVOID_RESTR then
        safe_call(anom_obj.force_set_restrictor_type, anom_obj, NONE_RESTR)
        dbg_log("RESTR", "cleared default-avoid (type 2->3) on %s",
            tostring(safe_call(anom_obj.name, anom_obj)))
    end
end


-- [ Anomaly Cache ]--

local ignored_anomalies_hash = nil
local ignored_anomalies_patterns = nil

-- Sort a flat ignore list into exact-name hash entries (those ending in _<digits>) and
-- substring patterns (everything else, matched with sf in is_always_skip_anomaly).
local function ingest_ignore_list(t)
    if not t then return end
    for i = 1, #t do
        local entry = t[i]
        if entry:match("_%d+$") then
            ignored_anomalies_hash[entry] = true
        else
            tinsert(ignored_anomalies_patterns, entry)
        end
    end
end

local function init_ignored_anomalies()
    if ignored_anomalies_hash then return end

    ignored_anomalies_hash = {}
    ignored_anomalies_patterns = {}

    if not zz_priler_nda_anomalies_settings then return end

    ingest_ignore_list(zz_priler_nda_anomalies_settings.nda_always_ignore_anom)

    -- Per-location hardcoded fields are optional: with the toggle off, NDA manages them
    -- (avoid / suppress damage / loot guard sees corpses there) instead of skipping them.
    if get_mcm_setting("legacy_anomaly_ignores", true) then
        ingest_ignore_list(zz_priler_nda_anomalies_settings.nda_legacy_ignore_anom)
    end
end

local function is_always_skip_anomaly(anom_name)
    if not anom_name then return true end
    init_ignored_anomalies()
    
    if ignored_anomalies_hash[anom_name] then return true end
    
    for i = 1, #ignored_anomalies_patterns do
        if sf(anom_name, ignored_anomalies_patterns[i]) then return true end
    end
    
    return false
end

local function rebuild_anomaly_cache()
    anomaly_cache = {}
    
    local lvl_name = level.name()
    if not lvl_name then
        cache_valid = true
        return
    end
    cache_level = lvl_name
    
    local fields = bind_anomaly_field and bind_anomaly_field.fields_by_names
    if not fields then 
        dbg_verbose("CACHE", "No anomaly fields found")
        cache_valid = true
        return 
    end
    
    local count = 0
    local skipped = 0
    local skip_reasons = { always_skip = 0, zone_disabled = 0, no_pos = 0, no_name = 0 }
    local clear_avoid = get_mcm_setting("clear_avoid_restrictors", true)

    for _, v in pairs(fields) do
        local anom_obj = v and v.object
        if anom_obj then
            -- Declaw the engine global-avoid wall on EVERY online field (even ones NDA
            -- later skips), so NDA's own avoidance/push-through is the sole authority
            if clear_avoid then neutralize_default_avoid(anom_obj) end
            local anom_id = safe_call(anom_obj.id, anom_obj)
            if anom_id and anom_id ~= 65535 then
                local se_obj = alife_object(anom_id)

                if se_obj then
                    local anom_name = safe_call(se_obj.name, se_obj)
                    local skip_reason = nil

                    if not anom_name then
                        skip_reason = "no_name"
                    elseif is_always_skip_anomaly(anom_name) then
                        skip_reason = "always_skip"
                    else
                        local is_active = is_anomaly_zone_enabled(anom_obj)
                        if not is_active then skip_reason = "zone_disabled" end

                        if is_active then
                            local pos = safe_call(anom_obj.position, anom_obj)
                            if pos and pos.x and pos.y and pos.z then
                                local section = safe_call(se_obj.section_name, se_obj) or "unknown"
                                tinsert(anomaly_cache, {
                                    id = anom_id,
                                    name = anom_name,
                                    pos = vector():set(pos.x, pos.y, pos.z),
                                    section = section
                                })
                                count = count + 1
                            else
                                skip_reason = "no_pos"
                            end
                        end
                    end

                    if skip_reason then
                        skipped = skipped + 1
                        skip_reasons[skip_reason] = (skip_reasons[skip_reason] or 0) + 1
                    end
                end
            end
        end
    end

    cache_valid = true
    cache_built_at = time_global()
    dbg_log("CACHE", "Rebuilt: %d anomalies on %s (skipped %d: zone_disabled=%d always=%d nopos=%d noname=%d)",
        count, lvl_name, skipped,
        skip_reasons.zone_disabled,
        skip_reasons.always_skip, skip_reasons.no_pos, skip_reasons.no_name)
end

local function invalidate_cache()
    cache_valid = false
end

local function ensure_cache()
    local current_level = level.name()
    -- Anomalies have no enable/disable callback, so a cache built when a zone was on
    -- would treat it as active forever. Dynamic anomalies (Arrival, base shuffle) toggle
    -- on their own timers; refresh on a short interval so a temp-disabled zone drops out
    -- and NPCs can cross while it is off. 0 disables the timed refresh
    local refresh_ms = get_mcm_setting("anomaly_state_refresh", 2) * 1000
    local stale = refresh_ms > 0 and (time_global() - cache_built_at) >= refresh_ms
    if not cache_valid or cache_level ~= current_level or stale then
        rebuild_anomaly_cache()
        
        -- refresh debug markers if needed
        if cached_show_debug_anomalies then
            CreateTimeEvent("nda_debug_markers", "refresh", 0.5, function()
                if cached_show_debug_anomalies and cache_valid then
                    local count = 0
                    for _, anom in ipairs(anomaly_cache) do
                        if level.map_has_object_spot(anom.id, "anomaly_disabled") ~= 0 then
                            level.map_remove_object_spot(anom.id, "anomaly_disabled")
                        end
                        local marker_text = sformat("NDA: %s\\n%s", anom.name, anom.section)
                        level.map_add_object_spot_ser(anom.id, "anomaly_disabled", marker_text)
                        count = count + 1
                    end
                    debug_anomalies_shown = true
                    dbg_log("DEBUG", "Refreshed %d anomaly markers on map", count)
                end
                return true
            end)
        end
    end
end


-- [ NPC Checks ]--

local function is_ignore_npc(npc)
    local id = npc:id()
    local section = npc:section()
    local profile = npc:profile_name()
    
    if zz_priler_nda_npc_settings.demonized_ignore_npc[section] then
        dbg_verbose("IGNORE", "NPC [%s] ignored by section [%s]", npc:name(), section)
        return true
    end
    if zz_priler_nda_npc_settings.demonized_ignore_npc[profile] then
        dbg_verbose("IGNORE", "NPC [%s] ignored by profile [%s]", npc:name(), profile)
        return true
    end
    if get_object_story_id(id) then
        dbg_verbose("IGNORE", "NPC [%s] ignored by story_id [%s]", npc:name(), get_object_story_id(id))
        return true
    end
    if IsTrader(npc) then
        dbg_verbose("IGNORE", "NPC [%s] ignored - is trader", npc:name())
        return true
    end
    return false
end

local function is_companion_npc(npc)
    -- if not is_valid_object(npc) then return false end
    -- local has_info = safe_call(npc.has_info, npc, "npcx_is_companion")
    -- return has_info == true
    if not npc then return false end
    return npc:has_info("npcx_is_companion")
end

local function is_task_target_npc(npc)
    if not npc then return false end
    
    -- Check story ID - story NPCs are quest-critical and should be protected
    local npc_id = npc:id()
    if get_object_story_id and get_object_story_id(npc_id) then
        return true
    end
    
    -- Check if NPC has escort infoportion
    if npc:has_info("npcx_beh_escort_target") then
        return true
    end
    
    return false
end

local function get_npc_community(npc)
    if not is_valid_object(npc) then return nil end
    return safe_call(npc.character_community, npc)
end

-- True when the NPC is calm (no enemy) in a movement state whose immunity toggle is on:
-- walking under walking_immunity, standing under standing_immunity. In an immune state the
-- NPC is treated as fully aware: it always detects/avoids anomalies and takes no anomaly
-- damage. Running and combat still roll (panic/haste = mistakes).
-- Standing has its own toggle so logic anchors (guard posts, campfires, animpoints) placed
-- inside anomaly fields don't become death traps even when walkers are left mortal
-- (thank you Arrival/DAO).
local function is_safe_immune_state(npc)
    if not is_valid_object(npc) then return false end
    if safe_call(npc.best_enemy, npc) then return false end           -- in combat
    local mt = safe_call(npc.movement_type, npc)
    if mt == move.walk  then return get_mcm_setting("walking_immunity", true) end
    if mt == move.stand then return get_mcm_setting("standing_immunity", true) end
    return false
end

-- [ Anomaly-Kill Rate Limiter ]--
-- Caps confirmed anomaly kills per rolling minute, separately per faction and per rank.
-- An NPC is protected (anomaly damage suppressed) if EITHER its faction OR its rank has
-- already reached its cap inside the window. Cap 0 = unlimited. Kills are recorded only on
-- confirmed, attributed deaths (check_anomaly_deaths); the gate below reads the counts.
local KILL_WINDOW_MS   = 60000   -- 1 minute rolling window
local kill_log_global  = {}      -- flat array of every confirmed anomaly-death stamp (universal cap)
local kill_log_faction = {}      -- community id keyed to an array of death time_global() stamps
local kill_log_rank    = {}      -- rank name keyed to an array of death time_global() stamps

-- Prune a flat timestamp list to the window and return (count, list_or_nil).
-- Stamps are appended in time_global order (monotonic within a session), so list[1] is the
-- oldest: if it is still fresh, nothing is stale and we return the same list with no alloc.
-- Only when the head is stale do we compact into a new table (nil when nothing survives).
local function prune_count(list, now)
    if not list or list[1] == nil then return 0, nil end
    local cutoff = now - KILL_WINDOW_MS
    if list[1] >= cutoff then return #list, list end
    local kept = {}
    for i = 1, #list do
        if list[i] >= cutoff then kept[#kept + 1] = list[i] end
    end
    return #kept, (#kept > 0) and kept or nil
end

-- Count recent entries for `key` in a keyed log, writing back the pruned list.
local function count_recent_kills(log, key, now)
    local n, kept = prune_count(log[key], now)
    log[key] = kept
    return n
end

local function record_anomaly_kill(community, rank, now)
    kill_log_global[#kill_log_global + 1] = now
    if community then
        local l = kill_log_faction[community]
        if not l then l = {}; kill_log_faction[community] = l end
        l[#l + 1] = now
    end
    -- Match the gate's fallback (should_enable_anomaly_damage uses "novice" when the live
    -- rank lookup fails) so a kill captured with a missing/unknown rank still lands in the
    -- same bucket the cap check reads, instead of an orphan "unknown" key nothing counts.
    if not rank or rank == "unknown" then rank = "novice" end
    local l = kill_log_rank[rank]
    if not l then l = {}; kill_log_rank[rank] = l end
    l[#l + 1] = now
end

-- (capped, which) -- true if this NPC's faction OR rank has hit its per-minute cap.
-- Returns false when the master toggle is off or both relevant caps are 0 (unlimited).
local function kill_cap_reached(community, rank, now)
    if not get_mcm_setting("kill_rate_limit", true) then return false end
    -- Universal cap: total confirmed anomaly kills in the window across everyone. Hit it and
    -- all NPCs are protected (no anomaly damage) until the rolling window frees up.
    local gcap = get_mcm_setting("kill_cap_global", 3)
    if gcap > 0 then
        local n, kept = prune_count(kill_log_global, now)
        kill_log_global = kept or {}
        if n >= gcap then return true, "global" end
    end
    if community then
        local cap = get_mcm_setting("kill_cap_faction_" .. community, 0)
        if cap > 0 and count_recent_kills(kill_log_faction, community, now) >= cap then
            return true, "faction"
        end
    end
    if rank then
        local cap = get_mcm_setting("kill_cap_rank_" .. rank, 0)
        if cap > 0 and count_recent_kills(kill_log_rank, rank, now) >= cap then
            return true, "rank"
        end
    end
    return false
end

local function should_enable_anomaly_damage(npc)
    if not is_valid_stalker(npc) then return false, "invalid" end
    if npc:id() == 0 then return true, "actor" end

    local community = get_npc_community(npc)
    if not community then return true, "no_community" end

    -- MCM-driven per-community damage opt-out (overrides hardcoded tables for these communities)
    if community == "greh" and get_mcm_setting("greh_ignore_damage", true) then
        return false, "mcm_greh_no_damage"
    end
    if community == "monolith" and get_mcm_setting("monolith_ignore_damage", true) then
        return false, "mcm_monolith_no_damage"
    end
    if community == "zombied" and get_mcm_setting("zombied_ignore_damage", false) then
        return false, "mcm_zombied_no_damage"
    end

    if zz_priler_nda_npc_settings and community ~= "greh" and community ~= "monolith"
            and community ~= "zombied" then
        if zz_priler_nda_npc_settings.nda_always_full_ignore_community and
           zz_priler_nda_npc_settings.nda_always_full_ignore_community[community] then
            return false, "full_ignore_community"
        end

        if zz_priler_nda_npc_settings.nda_no_damage_community and
           zz_priler_nda_npc_settings.nda_no_damage_community[community] then
            return false, "no_damage_community"
        end
    end

    if is_ignore_npc(npc) then return false, "ignore_npc" end
    if is_companion_npc(npc) then return false, "companion" end
    if is_task_target_npc(npc) then return false, "task_target" end

    -- Anomaly-kill rate limit: if this NPC's faction or rank already hit its per-minute
    -- kill cap, protect it (suppress damage) until the rolling window frees up. Independent
    -- of combat -- the cap exists to stop mass die-offs, which mostly happen mid-fight.
    do
        local rank_name = "novice"
        if ranks and ranks.get_obj_rank_name then
            rank_name = safe_call(ranks.get_obj_rank_name, npc) or "novice"
        end
        local capped, which = kill_cap_reached(community, rank_name, time_global())
        if capped then return false, "kill_cap_" .. which end
    end

    -- Combat-only damage: NPCs only take anomaly damage while fighting (best_enemy set).
    -- Out of combat they still detect/avoid normally but never get chipped by zones they
    -- calmly pass near. Broader than walking_immunity (covers running out-of-combat too).
    --
    -- NOTE: when this is ON (default) it fully subsumes walking_immunity, standing_immunity,
    -- safe_grace_period, and the standing/walking/running and rank miss multipliers below:
    -- every out-of-combat NPC returns here, and in-combat NPCs skip those blocks (they all
    -- require no enemy). Those finer-grained features only take effect when this is OFF.
    if get_mcm_setting("combat_only_damage", true) and not safe_call(npc.best_enemy, npc) then
        return false, "not_in_combat"
    end

    -- Calm-state immunity + grace period (pairs with guaranteed avoidance below).
    -- An NPC in an immune movement state (walking or standing, each under its own toggle,
    -- no enemy) takes no anomaly damage and we stamp its last-safe time. When it transitions
    -- to running, the grace window keeps it protected for `safe_grace_period` more seconds
    -- so a bolting NPC isn't instantly chipped. Combat is always excluded: best_enemy set
    -- means no immunity, no grace.
    if not safe_call(npc.best_enemy, npc) then
        local id = npc:id()
        local st = npc_state[id]
        if is_safe_immune_state(npc) then
            if not st then st = {}; npc_state[id] = st end
            st.last_safe_time = time_global()
            return false, "safe_immune"
        end
        -- Running/other out-of-combat: still protected during the grace window.
        local grace_ms = get_mcm_setting("safe_grace_period", 10) * 1000
        if grace_ms > 0 and st and st.last_safe_time
                and (time_global() - st.last_safe_time) <= grace_ms then
            return false, "safe_grace"
        end
    end

    if get_mcm_setting("immune_zero_miss_chance", true) then
        local base_miss = get_rank_miss_chance(npc)
        if base_miss <= 0 then
            return false, "immune_zero_miss"
        end
    end
    
    return true, "normal"
end

-- NPCs on these xr_logic schemes are bound to a fixed anchor and don't pathfind.
-- Adding path restrictions just churns clear/add every tick and keeps tripping stuck recovery.
local STATIC_POST_SCHEMES = {
    camper      = true,  -- xr_camper: sniper/fixed firing position
    remark      = true,  -- xr_remark: standing guard post
    animpoint   = true,  -- xr_animpoint: sit/lean/stand at anchor
    smartcover  = true,  -- xr_smartcover: smart cover anchor
    sleeper     = true,  -- xr_sleeper: sleeping
    kamp        = true,  -- xr_kamp: campfire idle
}

local function is_static_post_npc(npc)
    if not npc then return false end
    local st = db.storage[npc:id()]
    if not st then return false end
    return STATIC_POST_SCHEMES[st.active_scheme] == true
end

local function should_add_restrictions(npc)
    if not is_valid_stalker(npc) then return false end

    local community = get_npc_community(npc)
    if not community then return true end

    -- MCM-driven per-community restriction opt-out (overrides hardcoded tables for these communities)
    if community == "greh" and get_mcm_setting("greh_ignore_restrictions", true) then
        return false
    end
    if community == "monolith" and get_mcm_setting("monolith_ignore_restrictions", false) then
        return false
    end
    if community == "zombied" and get_mcm_setting("zombied_ignore_restrictions", true) then
        return false
    end

    if zz_priler_nda_npc_settings and community ~= "greh" and community ~= "monolith"
            and community ~= "zombied" then
        if zz_priler_nda_npc_settings.nda_always_full_ignore_community and
           zz_priler_nda_npc_settings.nda_always_full_ignore_community[community] then
            return false
        end

        if zz_priler_nda_npc_settings.nda_no_evade_community and
           zz_priler_nda_npc_settings.nda_no_evade_community[community] then
            return false
        end
    end

    if is_ignore_npc(npc) then return false end
    if is_companion_npc(npc) then return false end
    if is_task_target_npc(npc) then return false end
    if is_static_post_npc(npc) then return false end

    return true
end


-- [ NPC Anomaly Config ]--

local function configure_npc_anomaly_interaction(npc)
    if not is_valid_stalker(npc) then return end
    
    local should_damage, reason = should_enable_anomaly_damage(npc)
    safe_call(npc.set_enable_anomalies_damage, npc, should_damage)
    -- Anomaly-feel (pathfinding) flag is owned by update_npc_restrictions / set_npc_feel.

    dbg_verbose("CONFIG", "NPC [%s] damage=%s (%s)",
        npc:name() or "?", tostring(should_damage), reason)
end


-- [ Rank & Movement ]--

local RANK_MCM_KEYS = {
    ["novice"] = "rank_novice_miss_chance",
    ["trainee"] = "rank_trainee_miss_chance",
    ["experienced"] = "rank_experienced_miss_chance",
    ["professional"] = "rank_professional_miss_chance",
    ["veteran"] = "rank_veteran_miss_chance",
    ["expert"] = "rank_expert_miss_chance",
    ["master"] = "rank_master_miss_chance",
    ["legend"] = "rank_legend_miss_chance"
}

local RANK_DEFAULTS = {
    ["novice"] = 75,
    ["trainee"] = 50,
    ["experienced"] = 30,
    ["professional"] = 15,
    ["veteran"] = 10,
    ["expert"] = 5,
    ["master"] = 0,
    ["legend"] = 0
}

function get_rank_miss_chance(npc)
    if not is_valid_object(npc) then return 50 end
    
    local rank = nil
    if ranks and ranks.get_obj_rank_name then
        rank = safe_call(ranks.get_obj_rank_name, npc)
    end
    if not rank then rank = "novice" end
    
    local setting_key = RANK_MCM_KEYS[rank] or "rank_novice_miss_chance"
    local default_val = RANK_DEFAULTS[rank] or 100
    
    return get_mcm_setting(setting_key, default_val)
end

local function get_movement_state_multiplier(npc)
    if not is_valid_object(npc) then return 1.0 end
    
    local has_enemy = false
    local best_enemy = safe_call(npc.best_enemy, npc)
    if best_enemy then has_enemy = true end
    
    if has_enemy then
        return get_mcm_setting("combat_miss_multiplier", 3.0)
    end
    
    local movement = safe_call(npc.movement_type, npc)
    if not movement then return 1.0 end
    
    if movement == move.stand then
        return get_mcm_setting("standing_miss_multiplier", 0.3)
    elseif movement == move.walk then
        return get_mcm_setting("walking_miss_multiplier", 0.7)
    elseif movement == move.run then
        return get_mcm_setting("running_miss_multiplier", 1.3)
    end
    
    return 1.0
end

local function get_movement_state_name(npc)
    if not is_valid_object(npc) then return "unknown" end
    
    local best_enemy = safe_call(npc.best_enemy, npc)
    if best_enemy then return "combat" end
    
    local movement = safe_call(npc.movement_type, npc)
    if not movement then return "unknown" end
    
    if movement == move.stand then return "standing"
    elseif movement == move.walk then return "walking"
    elseif movement == move.run then return "running"
    end
    return "unknown"
end


-- [ Distance Checks ]--

local function get_nearby_anomalies(npc_pos, radius)
    if not npc_pos then return {} end
    local found = {}

    for _, anom in ipairs(anomaly_cache) do
        if anom.pos then
            local dist = npc_pos:distance_to(anom.pos)
            if dist <= radius then
                tinsert(found, { anom = anom, dist = dist })
            end
        end
    end

    -- Closest first, so the MAX_RESTRICTIONS_PER_NPC cap spends its budget on the nearest
    -- (most imminent) threats instead of whatever happened to come first in cache order.
    table.sort(found, function(a, b) return a.dist < b.dist end)

    local result = {}
    for i = 1, #found do result[i] = found[i].anom end
    return result
end

local function get_closest_anomaly(npc_pos)
    if not npc_pos then return nil, 99999 end
    
    local closest = nil
    local closest_dist = 99999
    
    for _, anom in ipairs(anomaly_cache) do
        if anom.pos then
            local dist = npc_pos:distance_to(anom.pos)
            if dist < closest_dist then
                closest_dist = dist
                closest = anom
            end
        end
    end
    
    return closest, closest_dist
end


-- [ Anomaly Avoidance ]--

local function clear_npc_restrictions(npc)
    if not is_valid_object(npc) then return end
    local current = safe_call(npc.in_restrictions, npc) or ""
    if current ~= "" then
        safe_call(npc.remove_restrictions, npc, "", current)
        dbg_verbose("RESTRICT", "Cleared restrictions for [%s]", npc:name() or "?")
    end
    local st = npc_state[npc:id()]
    if st then st.restrictions = nil end
end

-- Order-independent equality for two restriction (anomaly-name) lists. Used to avoid
-- re-issuing an unchanged restriction set: add_restrictions/remove_restrictions force the
-- engine to rebuild the NPC's path, and doing that every tick produces a visible ~2s
-- stutter-step. We only re-apply when the set actually changes.
local function same_restriction_set(a, b)
    if not a or not b then return false end
    if #a ~= #b then return false end
    local seen = {}
    for i = 1, #a do seen[a[i]] = true end
    for i = 1, #b do
        if not seen[b[i]] then return false end
    end
    return true
end

-- True if `detected` contains an anomaly the NPC hadn't already encountered (`known_before`,
-- a name->true set). Only a genuinely new threat forces an urgent reroute -- a remembered
-- anomaly re-entering the set (e.g. a dynamic zone blinking back on) does not. Distance-gated:
-- only a new anomaly that's CLOSE forces the reroute. A far one entering the detection rim
-- still gets its border set, but forcing a rebuild for it every tick is the ~2s move stutter.
local function has_close_new_anomaly(detected, known_before, npc_pos, max_dist, cache_by_name)
    for i = 1, #detected do
        local name = detected[i]
        if not known_before[name] then
            local c_pos = cache_by_name[name]
            if c_pos and npc_pos:distance_to(c_pos) <= max_dist then
                return true
            end
        end
    end
    return false
end

-- Per-tick snapshot of online stalker positions, rebuilt at the top of each periodic
-- tick. Lets the feeler election run without per-NPC engine spatial queries.
local tick_npc_positions = {}

-- Per-tick anomaly name->pos map, built ONCE at the top of nda_periodic_tick from
-- anomaly_cache and reused by every NPC's memory bookkeeping below. Avoids rebuilding an
-- O(#anomaly_cache) table per NPC per tick (was done twice per NPC in update_npc_restrictions).
local tick_cache_by_name = {}

-- Elect a feeler iff no lower-id stalker (any squad) is within SQUAD_CONTENTION_RADIUS, so
-- two nearby bolt-throw renders can't contest the skeleton/IK locks. A lone NPC always wins;
-- in a crowd only the lowest id wins, and winners are always at least the radius apart.
local function is_feeler_elected(self_id, self_pos, self_squad_id)
    for i = 1, #tick_npc_positions do
        local e = tick_npc_positions[i]
        if e.id < self_id and self_pos:distance_to(e.pos) <= SQUAD_CONTENTION_RADIUS then
            return false
        end
    end
    return true
end

-- Sets the engine anomaly feel flag for the NPC.
-- Deduped using st.feel_on to prevent spamming the engine every tick.
-- States:
-- 1. ON: NPC throws bolts and the engine handles routing.
-- 2. OFF: Uses pure restriction routing.
-- Managed exclusively here to prevent configure_npc_anomaly_interaction
-- from overwriting an active probe during throttled updates.
local function set_npc_feel(npc, st, on)
    if st.feel_on == on then return end
    safe_call(npc.set_enable_anomalies_pathfinding, npc, on)
    st.feel_on = on
    dbg_log("FEEL", "[%s] %s", npc:name() or "?", on and "ON" or "OFF")
end

-- Set the squad rush flag. xr_reach_task forces move.walk on members each Think unless
-- squad.rush_to_target is set, so this field (not a per-NPC set_movement_type) is what
-- propagates run across a squad. No-op for solo NPCs, which the direct run call handles.
local function set_squad_rush(npc, on)
    local squad = safe_call(get_object_squad, npc)
    if squad then squad.rush_to_target = on end
end

-- Commit the NPC to running: direct run for solo NPCs, squad rush flag for squad members.
local function set_squad_running(npc)
    safe_call(npc.set_movement_type, npc, move.run)
    set_squad_rush(npc, true)
    dbg_log("SQUAD_RUN", "[%s] rush_to_target=true", npc:name() or "?")
end

-- Mark one NPC as pushing through: drop restrictions/feel and set state. Doesn't touch the
-- squad rush flag (set_squad_running's job). `single` = in-contact mode (exits when clear of
-- any damage radius); field mode (stuck) exits only when no anomalies remain nearby.
local function enter_push_through(npc, st, reason, single)
    st.pre_push_run        = (safe_call(npc.movement_type, npc) == move.run)
    st.push_through        = true
    st.push_through_single = single and true or nil
    st.restrictions        = nil
    st.restrict_start      = nil
    st.restrict_anchor_pos = nil
    st.avoid_since         = nil
    st.probed              = nil
    st.probe_until         = nil
    set_npc_feel(npc, st, false)
    clear_npc_restrictions(npc)
    dbg_log("PUSH_THROUGH", "[%s] sprinting through (%s, %s)", npc:name() or "?", reason, single and "single" or "field")
end

-- Stop sprinting: drop the squad rush flag, restore walk (unless the NPC was already running
-- before the commit), and clear the push_through state fields.
local function exit_push_through(npc, st)
    set_squad_rush(npc, false)
    if not st.pre_push_run then
        safe_call(npc.set_movement_type, npc, move.walk)
    end
    st.push_through        = nil
    st.push_through_single = nil
    st.push_anchor_pos     = nil
    st.push_anchor_time    = nil
    st.pre_push_run        = nil
end

-- Full avoidance teardown: drop restrictions and feel, exit any push_through, and clear the
-- routing/probe/contact state. Used when an NPC leaves all fields or the interaction bubble.
local function reset_avoidance_state(npc, st)
    if st.restrictions then clear_npc_restrictions(npc) end
    set_npc_feel(npc, st, false)
    if st.push_through then exit_push_through(npc, st) end
    st.restrict_start      = nil
    st.restrict_anchor_pos = nil
    st.avoid_since         = nil
    st.probed              = nil
    st.probe_until         = nil
    st.took_damage         = nil
end

-- True if a DIFFERENT squad (or solo NPC) is pushing through within SQUAD_CONTENTION_RADIUS
-- of `pos`. my_identifier is the squad id, or the NPC id for solo NPCs.
local function other_squad_pushing_near(pos, my_identifier)
    for id, st in pairs(npc_state) do
        if st.push_through then
            local obj = level.object_by_id(id)
            -- Skip dead bodies: npc_state survives until corpse despawn (~30 min) since
            -- npc_on_net_destroy doesn't fire on death, so a corpse that died mid-push
            -- would otherwise block every commit in its radius.
            if obj and safe_call(obj.alive, obj) then
                local obj_pos = safe_call(obj.position, obj)
                if obj_pos and pos:distance_to(obj_pos) <= SQUAD_CONTENTION_RADIUS then
                    local sq = safe_call(get_object_squad, obj)
                    local their_identifier = sq and sq.id or id
                    if their_identifier ~= my_identifier then
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- Push the committer + eligible squadmates into push_through, then set the squad running.
-- Takes an id and re-resolves npc/st since a deferred call may run after the NPC moved.
local function commit_push_through(self_id, reason, single)
    local npc = level.object_by_id(self_id)
    if not is_valid_stalker(npc) then return end
    local st = npc_state[self_id]
    if not st then return end

    enter_push_through(npc, st, reason, single)

    local squad = safe_call(get_object_squad, npc)
    if squad then
        for member in squad:squad_members() do
            if member.id ~= self_id then
                local mate = level.object_by_id(member.id)
                if is_valid_stalker(mate) and should_add_restrictions(mate) then
                    local mate_id = mate:id()
                    local mate_st = npc_state[mate_id]
                    if not mate_st then mate_st = {}; npc_state[mate_id] = mate_st end
                    if not mate_st.push_through then
                        enter_push_through(mate, mate_st, reason .. " (squadmate)", single)
                    end
                end
            end
        end
    end

    set_squad_running(npc)
end

-- Gate for a push_through commit; both guards exist to avoid the skeleton-mutex deadlock:
--   * DENY outright if another squad is already pushing nearby (stuck/field commits only), or
--   * DEFER by FEEL_TO_RUSH_DELAY if the NPC is mid bolt-throw, so its render finishes first.
-- Otherwise commit now. The actual work is in commit_push_through.
local function request_push_through(npc, st, reason, single)
    local self_pos = safe_call(npc.position, npc)
    local squad = safe_call(get_object_squad, npc)
    local self_id = npc:id()
    local my_identifier = squad and squad.id or self_id

    if not single and self_pos and other_squad_pushing_near(self_pos, my_identifier) then
        dbg_log("PUSH_THROUGH", "[%s] commit denied (other squad pushing in area)",
            npc:name() or "?")
        return
    end

    if st.feel_on then
        dbg_log("PUSH_THROUGH", "[%s] commit deferred (was feeling)", npc:name() or "?")
        CreateTimeEvent("nda_commit_delay", tostring(self_id), FEEL_TO_RUSH_DELAY, function()
            commit_push_through(self_id, reason, single)
            return true
        end)
    else
        commit_push_through(self_id, reason, single)
    end
end

-- True once the NPC has gone npc_stuck_timeout seconds without STUCK_PROGRESS_DIST of net
-- progress. Re-anchors on progress. anchor_key/time_key pick the state fields, so it serves
-- both stalls.
local function stuck_since(st, anchor_key, time_key, npc_pos, now)
    if not st[anchor_key] or not st[time_key]
       or npc_pos:distance_to(st[anchor_key]) >= STUCK_PROGRESS_DIST then
        st[anchor_key], st[time_key] = npc_pos, now
        return false
    end
    return (now - st[time_key]) > get_mcm_setting("npc_stuck_timeout", 20) * 1000
end

-- Stall test shared by both avoidance branches.
-- Soft trigger: no STUCK_PROGRESS_DIST of net displacement within stuck_ms (NPC pinned in place)
-- Hard trigger: in unbroken avoidance for STUCK_HARD_MULT * stuck_ms regardless of movement (NPC pacing a chokepoint
-- keeps re-anchoring the soft timer, so this is the guaranteed escape)
local function avoidance_stalled(st, npc_pos, now, stuck_ms)
    if not st.restrict_anchor_pos or not st.restrict_start then
        st.restrict_anchor_pos = npc_pos
        st.restrict_start      = now
    elseif npc_pos:distance_to(st.restrict_anchor_pos) >= STUCK_PROGRESS_DIST then
        st.restrict_anchor_pos = npc_pos
        st.restrict_start      = now
    end

    if not st.avoid_since then st.avoid_since = now end

    if (now - st.restrict_start) > stuck_ms then return true end
    if (now - st.avoid_since) > stuck_ms * STUCK_HARD_MULT then return true end
    return false
end

-- Return an NPC to engine-default anomaly behavior: no feel-avoidance, no forced damage,
-- restrictions cleared, walk restored
local function reset_npc_anomaly_state(npc)
    if not is_valid_object(npc) then return end
    safe_call(npc.set_enable_anomalies_damage, npc, false)
    set_squad_rush(npc, false)
    local st = npc_state[safe_call(npc.id, npc)]
    if st then
        if st.restrictions then clear_npc_restrictions(npc) end
        set_npc_feel(npc, st, false)
        if st.push_through and not st.pre_push_run then
            safe_call(npc.set_movement_type, npc, move.walk)
        end
        st.restrict_start      = nil
        st.restrict_anchor_pos = nil
        st.avoid_since         = nil
        st.push_through        = nil
        st.push_through_single = nil
        st.push_anchor_pos     = nil
        st.push_anchor_time    = nil
        st.pre_push_run        = nil
        st.probed              = nil
        st.probe_until         = nil
    else
        -- No tracked state (state wiped, or NPC flagged earlier this session): force the
        -- engine flag off directly, since set_npc_feel needs st to dedupe
        safe_call(npc.set_enable_anomalies_pathfinding, npc, false)
    end
end

-- Capability probe for the engine npc:inside_anomaly() export (modded-exes build)
local engine_inside_anomaly_supported = nil

local function npc_inside_anomaly(npc)
    if engine_inside_anomaly_supported == nil then
        engine_inside_anomaly_supported = (type(npc.inside_anomaly) == "function")
        diag_log("INIT", "engine npc:inside_anomaly() %s",
            engine_inside_anomaly_supported and "available" or "absent, using distance fallback")
    end
    if not engine_inside_anomaly_supported then return nil end
    return safe_call(npc.inside_anomaly, npc) == true
end

local function update_npc_restrictions(npc, detection_radius)
    if not is_valid_stalker(npc) then return end

    local id = npc:id()
    local current_time = time_global()
    local st = npc_state[id]
    if not st then st = {}; npc_state[id] = st end

    local npc_pos = get_position_copy(npc)
    if not npc_pos then return end

    local radius = detection_radius or get_mcm_setting("base_detection_radius", 30)
    local nearby = get_nearby_anomalies(npc_pos, radius)

    -- Safety net: force-enable movement for any NPC in a damage radius, so a scheme that
    -- disabled movement can't park it in the zone.
    for _, anom in ipairs(nearby) do
        if anom.pos and npc_pos:distance_to(anom.pos) <= MIN_RESTRICT_DISTANCE then
            safe_call(npc.movement_enabled, npc, true)
            break
        end
    end

    if #nearby == 0 then
        reset_avoidance_state(npc, st)

        -- Decay anomaly memory while NPC is away from all anomaly fields.
        local mem_decay_ms = get_mcm_setting("anomaly_memory_decay", 30) * 1000
        if mem_decay_ms > 0 and st.known_anomalies then
            local known = st.known_anomalies
            local cache_by_name = tick_cache_by_name
            for anom_name, mem in pairs(known) do
                local stale = (current_time - mem.last_seen) > mem_decay_ms
                local c_pos = cache_by_name[anom_name]
                if not c_pos then
                    if stale then known[anom_name] = nil end
                elseif npc_pos:distance_to(c_pos) > 2 * radius and stale then
                    known[anom_name] = nil
                end
            end
            if next(known) == nil then st.known_anomalies = nil end
        end
        return
    end

    -- Push-through: NPC has committed to crossing (restrictions/feel already dropped). Re-
    -- assert the rush flag each tick since a squadmate exiting push_through clears it.
    if st.push_through then
        if st.push_through_single and not is_position_in_anomaly(npc_pos, MIN_RESTRICT_DISTANCE) then
            -- Single mode, clear of the damage AoE: end push_through and fall through to
            -- normal detection so restrictions can re-engage on any other nearby anomalies.
            exit_push_through(npc, st)
            dbg_log("PUSH_THROUGH", "[%s] cleared (out of damage AoE)", npc:name() or "?")
            -- fall through to normal detection/restriction logic
        else
            -- Still committed: keep restrictions/feel off and run. Direct set_movement_type
            -- here (not just the squad rush flag, which only moves xr_reach_task NPCs) makes
            -- propagated squadmates actually sprint instead of walking through defenseless.
            if st.restrictions then clear_npc_restrictions(npc) end
            set_npc_feel(npc, st, false)
            set_squad_rush(npc, true)
            safe_call(npc.set_movement_type, npc, move.run)

            -- Stuck while sprinting? (no net progress for the timeout)
            if stuck_since(st, "push_anchor_pos", "push_anchor_time", npc_pos, current_time) then
                if st.push_through_single then
                    -- escalate single -> field so it commits to crossing the whole cluster
                    st.push_through_single = nil
                    st.push_anchor_time    = current_time
                    dbg_log("PUSH_THROUGH", "[%s] stuck in single mode -> escalated to field",
                        npc:name() or "?")
                else
                    -- Field-stuck: reset the timer to avoid log spam. The per-tick direct run
                    -- (maintain block) is the only lever to get it moving.
                    -- TODO: add further escalation if NPCs are still stuck
                    st.push_anchor_time = current_time
                    dbg_log("PUSH_THROUGH", "[%s] stuck in field mode", npc:name() or "?")
                end
            end

            return
        end
    end

    -- In contact: took a hit since the last tick. Commit to sprinting out in single mode
    -- (exits as soon as clear of the damage AoE rather than the whole cluster).
    if st.took_damage then
        st.took_damage = nil
        request_push_through(npc, st, "in contact", true)
        return
    end

    -- Everything below is proactive avoidance (detection roll, feel election, restrictions).
    -- NPCs excluded from routing -- static-post jobs, companions, task targets, ignored
    -- sections -- still reach the push-through maintain + in-contact escape above, so a burning
    -- one always bolts; they just get no proactive routing. Gate here, not at the top.
    if not should_add_restrictions(npc) then return end

    local miss_chance = get_rank_miss_chance(npc)
    local state_mult = get_movement_state_multiplier(npc)
    local final_miss = mfloor(miss_chance * state_mult)
    final_miss = mmax(0, mmin(100, final_miss))

    -- Immune movement state (walking/standing, per their toggles) + not in combat =
    -- guaranteed detection (0 miss): always restrict/avoid every nearby anomaly.
    -- Pairs with the no-damage rule in should_enable_anomaly_damage.
    if is_safe_immune_state(npc) then
        final_miss = 0
        st.last_safe_time = current_time   -- feeds the running grace window (should_enable_anomaly_damage)
    end

    -- Anomalies the NPC already knew coming into this tick (memory + last tick's restricted
    -- set). Used to gate the reroute: a name in here re-entering the set isn't a new threat.
    local known_before = {}
    if st.known_anomalies then
        for name, mem in pairs(st.known_anomalies) do
            if mem.detected then known_before[name] = true end
        end
    end
    if st.restrictions then
        for _, n in ipairs(st.restrictions) do known_before[n] = true end
    end

    local detected = {}
    local rank = "unknown"
    if ranks and ranks.get_obj_rank_name then
        rank = safe_call(ranks.get_obj_rank_name, npc) or "unknown"
    end

    -- Engine truth for "physically touching a zone" when this build exports it; nil
    -- otherwise, in which case the per-anomaly distance test below stands alone
    local engine_inside = npc_inside_anomaly(npc)

    -- One-shot detection memory. Each anomaly is rolled ONCE per encounter; the outcome
    -- (detected/missed) is remembered and reused on later ticks, instead of re-rolling a missed
    -- anomaly every tick until it eventually passes. A record expires after anomaly_memory_decay,
    -- after which the anomaly may be rolled again. detected=true records also drive avoidance and
    -- the 2x-radius recall below; detected=false records only suppress the re-roll.
    local mem_decay_ms = get_mcm_setting("anomaly_memory_decay", 30) * 1000
    local mem_on = mem_decay_ms > 0
    local known = nil
    if mem_on then
        st.known_anomalies = st.known_anomalies or {}
        known = st.known_anomalies
    end

    for idx, anom in ipairs(nearby) do
        -- An anomaly the NPC is already inside can't be routed around, so don't treat it as a
        -- fresh detection -- push-through handles getting it out.
        local too_close = anom.pos and npc_pos:distance_to(anom.pos) < MIN_RESTRICT_DISTANCE

        -- Large zones have a center far from their rim, so the flat distance test can miss a
        -- zone the NPC is standing in. nearby is sorted closest-first, so when the engine
        -- confirms contact the first entry is that zone: routing around it is useless, skip it.
        if engine_inside == true and idx == 1 then
            if not too_close then
                local d = anom.pos and npc_pos:distance_to(anom.pos) or -1
                dbg_log("INSIDE", "[%s] engine inside_anomaly() caught [%s] at %.1fm (distance test missed, MIN=%d)",
                    npc:name() or "?", anom.name, d, MIN_RESTRICT_DISTANCE)
            end
            too_close = true
        end

        if too_close then
            dbg_verbose("DETECT", "[%s] skipped [%s] (already inside zone)",
                npc:name() or "?", anom.name)
        elseif get_mcm_setting("immune_zero_miss_chance", true) and final_miss <= 0 then
            tinsert(detected, anom.name)
            if mem_on then known[anom.name] = { last_seen = current_time, detected = true } end
        else
            local mem = mem_on and known[anom.name] or nil
            if mem and (current_time - mem.last_seen) <= mem_decay_ms then
                -- Already evaluated recently: reuse the outcome, no re-roll.
                if mem.detected then
                    tinsert(detected, anom.name)
                    mem.last_seen = current_time   -- keep a known hazard fresh while near
                end
            else
                -- First sighting (or forgotten since): roll once.
                local roll = mrand(1, 100)
                local hit = roll > final_miss
                if mem_on then known[anom.name] = { last_seen = current_time, detected = hit } end
                if hit then
                    tinsert(detected, anom.name)
                    dbg_log("DETECT", "[%s] (%s) detected [%s] (roll %d > %d%%)",
                        npc:name() or "?", rank, anom.name, roll, final_miss)
                else
                    dbg_verbose("DETECT", "[%s] (%s) missed [%s] (roll %d <= %d%%)",
                        npc:name() or "?", rank, anom.name, roll, final_miss)
                end
            end
        end

        if #detected >= MAX_RESTRICTIONS_PER_NPC then
            break
        end
    end

    if mem_on then
        local cache_by_name = tick_cache_by_name

        -- Extend avoidance to remembered HITS in the [radius, 2x radius] band, beyond the
        -- detection loop's reach, so an NPC keeps routing around a field it just moved past. A
        -- disabled dynamic anomaly has no cache pos this tick; skip it but keep it remembered
        -- (decay below handles removal) so its re-enable isn't treated as a brand-new threat.
        for anom_name, mem in pairs(known) do
            if #detected >= MAX_RESTRICTIONS_PER_NPC then break end
            if mem.detected then
                local c_pos = cache_by_name[anom_name]
                if c_pos then
                    local dist = npc_pos:distance_to(c_pos)
                    if dist <= 2 * radius and dist >= MIN_RESTRICT_DISTANCE then
                        local already = false
                        for _, n in ipairs(detected) do
                            if n == anom_name then already = true; break end
                        end
                        if not already then
                            tinsert(detected, anom_name)
                            mem.last_seen = current_time
                            dbg_verbose("MEMORY", "[%s] recalled [%s] (%.1fm)",
                                npc:name() or "?", anom_name, dist)
                        end
                    end
                end
            end
        end

        -- Decay by staleness, not cache-absence: a cycling anomaly in its off-phase keeps its
        -- record (so a fast blink doesn't read as new); only drop it once it's been unseen past
        -- the memory window, or it's gone far away and stale. Covers both hits and misses.
        for anom_name, mem in pairs(known) do
            local stale = (current_time - mem.last_seen) > mem_decay_ms
            local c_pos = cache_by_name[anom_name]
            if not c_pos then
                if stale then known[anom_name] = nil end
            elseif npc_pos:distance_to(c_pos) > 2 * radius and stale then
                known[anom_name] = nil
                dbg_verbose("MEMORY", "[%s] forgot [%s]", npc:name() or "?", anom_name)
            end
        end
    end

    -- FEEL election runs regardless of the detection roll: feel (engine routing + bolts) goes
    -- to ONE elected NPC per SQUAD_CONTENTION_RADIUS, which is the cell's scout. It must feel
    -- even on a tick it personally rolled a miss (with g_ai_die_in_anomaly = 0 the engine
    -- ignores anomalies otherwise) -- gating feel on the detection roll collapses to almost no
    -- feeling, since the lowest-id NPC usually isn't the one that detected. Detection gates
    -- restrictions (below), not feel.
    local feel_on = false
    if get_mcm_setting("engine_avoidance", true) then
        local self_squad = safe_call(get_object_squad, npc)
        local self_squad_id = self_squad and self_squad.id or nil
        feel_on = is_feeler_elected(id, npc_pos, self_squad_id)
    end
    set_npc_feel(npc, st, feel_on)

    if #detected > 0 then
        -- Apply restrictions (hard navmesh obstacles for shape-blocking types; a no-op for
        -- shapeless electric/acidic, which only the elected feeler can route around). Only
        -- re-issue on change -- re-applying an identical set every tick forces a path rebuild
        -- and makes the NPC stutter-step ~every 2s.
        if not same_restriction_set(detected, st.restrictions) then 
            -- Force an immediate reroute only for a CLOSE new anomaly. add_restrictions just
            -- updates the border set (silent -- the engine uses it on its next recompute);
            -- invalidate_restrictions forces the rebuild now. A far new anomaly entering the
            -- rim doesn't need that, so gate invalidate to within half the detection radius.
            local reroute = has_close_new_anomaly(detected, known_before, npc_pos, radius * 0.5, tick_cache_by_name)
            clear_npc_restrictions(npc)
            safe_call(npc.add_restrictions, npc, "", tconcat(detected, ","))
            if reroute then safe_call(npc.invalidate_restrictions, npc) end  -- 2026.6.1+ API
            st.restrictions = detected
            dbg_verbose("RESTRICT", "[%s] applied %d restrictions%s",
                npc:name() or "?", #detected, reroute and " (reroute)" or "")
        end

        -- Stuck routing around the field? Give up and sprint through.
        local stuck_ms = get_mcm_setting("npc_stuck_timeout", 20) * 1000
        if avoidance_stalled(st, npc_pos, current_time, stuck_ms) then
            request_push_through(npc, st, "stuck in field", false)
        end
    else
        -- Detected nothing this tick: clear restrictions and reset the stuck timer. FEEL
        -- stays as the election set it so the elected feeler can still feel-touch anomalies.
        clear_npc_restrictions(npc)
        st.restrict_start      = nil
        st.restrict_anchor_pos = nil
        st.avoid_since         = nil
    end
end


-- [ Anomaly Before Activate ]--

local function on_anomaly_before_activate(zone, obj, flags)
    if not is_mod_enabled() then return end
    if not obj then return end
    
    local obj_id = safe_call(obj.id, obj)
    if not obj_id or obj_id == 0 then return end
    
    local is_stalker = safe_call(IsStalker, obj)
    if not is_stalker then return end
    
    if get_mcm_setting("block_anomalies_on_corpses", true) then
        local alive = safe_call(obj.alive, obj)
        if not alive then
            flags.ret_value = false
            return
        end
    else
        local alive = safe_call(obj.alive, obj)
        if not alive then return end
    end
    
    if surge_started() then return end
    
    local should_damage, reason = should_enable_anomaly_damage(obj)
    
    if not should_damage then
        flags.ret_value = false
        dbg_verbose("BLOCK", "Blocked [%s] from [%s] (%s)", 
            zone:name() or "?", obj:name() or "?", reason)
        return
    end
    
    local zone_name = safe_call(zone.name, zone) or "unknown"
    local zone_section = safe_call(zone.section, zone) or "unknown"
    local rank = "unknown"
    if ranks and ranks.get_obj_rank_name then
        rank = safe_call(ranks.get_obj_rank_name, obj) or "unknown"
    end
    local state = get_movement_state_name(obj)
    local community = get_npc_community(obj) or "unknown"
    
    dbg_log("DAMAGE", "[%s] (%s %s) walked into [%s]", 
        obj:name() or "?", rank, state, zone_name)
    
    local st = npc_state[obj_id]
    if not st then st = {}; npc_state[obj_id] = st end
    st.took_damage = true
    st.last_anomaly = {
        name = zone_name,
        section = zone_section,
        time = time_global(),
        state = state,
        rank = rank,
        community = community,
        level = level.name(),          -- internal level id where contact happened
        pos = get_position_copy(obj)   -- victim position at moment of contact
    }
end


-- [ NPC Before Hit (Armor) ]--

local ANOMALY_PROTECTION_PATTERNS = {
    { pattern = "electra",      protection = "shock_protection" },
    { pattern = "electric",     protection = "shock_protection" },
    { pattern = "tesla",        protection = "shock_protection" },
    { pattern = "static",       protection = "shock_protection" },
    { pattern = "burner",       protection = "burn_protection" },
    { pattern = "thermal",      protection = "burn_protection" },
    { pattern = "fire",         protection = "burn_protection" },
    { pattern = "inferno",      protection = "burn_protection" },
    { pattern = "zharka",       protection = "burn_protection" },
    { pattern = "acidic",       protection = "chemical_burn_protection" },
    { pattern = "chemical",     protection = "chemical_burn_protection" },
    { pattern = "gas",          protection = "chemical_burn_protection" },
    { pattern = "fruit_punch",  protection = "chemical_burn_protection" },
    { pattern = "gravitational", protection = "strike_protection" },
    { pattern = "springboard",   protection = "strike_protection" },
    { pattern = "vortex",        protection = "strike_protection" },
    { pattern = "whirligig",     protection = "strike_protection" },
    { pattern = "galantine",     protection = "strike_protection" },
    { pattern = "tramplin",      protection = "strike_protection" },
    { pattern = "radioactive",  protection = "radiation_protection" },
    { pattern = "radiation",    protection = "radiation_protection" },
    { pattern = "psy",          protection = "telepatic_protection" },
    { pattern = "brain",        protection = "telepatic_protection" },
    { pattern = "telepatic",    protection = "telepatic_protection" },
}

local anomaly_protection_cache = {}

local function get_anomaly_protection_type(anomaly_section)
    if not anomaly_section then return nil end
    
    local cached = anomaly_protection_cache[anomaly_section]
    if cached ~= nil then
        return cached ~= false and cached or nil
    end
    
    local section_lower = anomaly_section:lower()
    for _, mapping in ipairs(ANOMALY_PROTECTION_PATTERNS) do
        if sf(section_lower, mapping.pattern) then
            anomaly_protection_cache[anomaly_section] = mapping.protection
            return mapping.protection
        end
    end
    
    anomaly_protection_cache[anomaly_section] = false
    return nil
end

local function get_npc_outfit_protection(npc, protection_type)
    if not is_valid_object(npc) or not protection_type then return 0 end
    
    local outfit = safe_call(npc.item_in_slot, npc, 7)
    if not outfit then return 0 end
    
    local outfit_section = safe_call(outfit.section, outfit)
    if not outfit_section then return 0 end
    
    local protection = SYS_GetParam(2, outfit_section, protection_type, 0)
    return protection or 0
end

function get_npc_dmg_mult(npc, anomaly)
    if not is_valid_object(npc) then return 1.0 end
    if not get_mcm_setting("enable_armor_damage_mult", true) then return 1.0 end
    if not anomaly then return 1.0 end
    
    local anomaly_section = safe_call(anomaly.section, anomaly)
    if not anomaly_section then return 1.0 end
    
    local protection_type = get_anomaly_protection_type(anomaly_section)
    if not protection_type then return 1.0 end
    
    local protection = get_npc_outfit_protection(npc, protection_type)
    local damage_mult = mmax(0, 1.0 - protection)
    
    dbg_verbose("ARMOR", "[%s] -> %s -> prot %.2f -> mult %.2f",
        anomaly_section, protection_type, protection, damage_mult)
    
    return damage_mult
end

local function on_npc_before_hit(npc, shit, bone_id, flags)
    if not is_mod_enabled() then return end
    if not npc or not shit then return end
    
    local alive = safe_call(npc.alive, npc)
    if not alive then return end
    
    local is_stalker = safe_call(IsStalker, npc)
    if not is_stalker then return end
    
    local who = shit.draftsman
    if not who then return end
    
    local is_anomaly = false
    if who.is_anomaly then
        is_anomaly = safe_call(who.is_anomaly, who)
    end
    if not is_anomaly then return end
    
    if get_mcm_setting("enable_armor_damage_mult", true) then
        local mult = get_npc_dmg_mult(npc, who)
        if mult < 1.0 then
            shit.power = shit.power * mult
        end
    end
end


-- [ Surge Detection ]--

function surge_started()
    local surge_active = surge_manager and surge_manager.is_loaded and 
                        surge_manager.is_loaded() and surge_manager.is_started and
                        surge_manager.is_started()
    local psy_active = psi_storm_manager and psi_storm_manager.is_loaded and
                      psi_storm_manager.is_loaded() and psi_storm_manager.is_started and
                      psi_storm_manager.is_started()
    return surge_active or psy_active
end


-- [ Death Detection ]--

local FACTION_NAMES = {
    ["stalker"] = "Loner",
    ["bandit"] = "Bandit",
    ["dolg"] = "Duty",
    ["freedom"] = "Freedom",
    ["monolith"] = "Monolith",
    ["army"] = "Military",
    ["ecolog"] = "Ecologist",
    ["killer"] = "Mercenary",
    ["greh"] = "Sin",
    ["renegade"] = "Renegade",
    ["isg"] = "ISG",
    ["csky"] = "Clear Sky",
    ["zombied"] = "Zombie",
}

local function get_faction_name(community)
    if not community then return "Unknown" end
    return FACTION_NAMES[community] or community
end

local function report_anomaly_death(npc, anomaly_info)
    local death_news = get_mcm_setting("debug_death_news", false)
    -- Report if the dedicated death-news option OR general debug logging is on.
    if not death_news and not is_debug_enabled() then return end
    if not is_valid_object(npc) then return end

    local victim_name = npc:name() or "unknown"
    local faction_name = get_faction_name(anomaly_info.community)
    local victim_rank = anomaly_info.rank or "unknown"
    local victim_state = anomaly_info.state or "unknown"

    -- Location: internal level id + rounded world coords captured at the moment of contact.
    local loc_level = anomaly_info.level or (level and level.name()) or "unknown"
    local loc_str = loc_level
    local p = anomaly_info.pos
    if p then
        loc_str = sformat("%s [%.0f, %.0f, %.0f]", loc_level, p.x, p.y, p.z)
    end

    printf("[NDA][DEATH] %s (%s %s) killed by %s (%s) at %s while %s",
        victim_name, victim_rank, faction_name,
        anomaly_info.name, anomaly_info.section, loc_str, victim_state)

    if death_news and db.actor then
        local news_text = sformat("%s (%s %s) killed by %s at %s while %s",
            victim_name, victim_rank, faction_name,
            anomaly_info.section, loc_str, victim_state)
        db.actor:give_game_news("NDA: Anomaly Kill", news_text, "ui_inGame2_PD_Dengi", 0, 8000, 0)
    end
end

-- Temporary map marker for an anomaly-killed corpse. Stock "red_location" spot type
-- (configs/ui/map_spots.xml) so no custom spot XML is needed.
local DEATH_SPOT_TYPE         = "red_location"
local DEATH_SPOT_DURATION_SEC = 300   -- 5 minutes

local function mark_anomaly_death_spot(npc, anomaly_info)
    if not get_mcm_setting("debug_death_map_spot", false) then return end
    if not is_valid_object(npc) then return end

    local id = npc:id()
    local hint = sformat("NDA: %s killed by %s",
        npc:name() or "stalker", (anomaly_info and anomaly_info.section) or "anomaly")

    if level.map_has_object_spot(id, DEATH_SPOT_TYPE) ~= 0 then
        level.map_remove_object_spot(id, DEATH_SPOT_TYPE)
    end
    -- Serialized add for the (about-to-go-offline) corpse, with the non-ser form as fallback.
    local ok = pcall(function()
        level.map_add_object_spot_ser(id, DEATH_SPOT_TYPE, hint)
    end)
    if not ok then
        ok = pcall(function()
            level.map_add_object_spot(id, DEATH_SPOT_TYPE, hint)
        end)
    end
    if not ok then return end
    dbg_log("DEATH", "Map spot added for corpse %s (expires in %ds)", tostring(id), DEATH_SPOT_DURATION_SEC)

    -- Auto-remove after the duration. Unique action id per corpse; Remove first so a
    -- re-mark of the same id can't stack two timers.
    RemoveTimeEvent("nda_death_spot", "spot_" .. id)
    CreateTimeEvent("nda_death_spot", "spot_" .. id, DEATH_SPOT_DURATION_SEC, function()
        if level.map_has_object_spot(id, DEATH_SPOT_TYPE) ~= 0 then
            level.map_remove_object_spot(id, DEATH_SPOT_TYPE)
            dbg_log("DEATH", "Map spot expired for corpse %s", tostring(id))
        end
        return true
    end)
end

local function check_anomaly_deaths(current_time)
    local to_remove = {}

    for npc_id, st in pairs(npc_state) do
        local anomaly_info = st.last_anomaly
        if anomaly_info then
            if (current_time - anomaly_info.time) > ANOMALY_ATTRIBUTION_TIMEOUT then
                tinsert(to_remove, npc_id)
            else
                local npc = level.object_by_id(npc_id)
                if npc then
                    local alive = safe_call(npc.alive, npc)
                    if not alive and not anomaly_info.reported then
                        anomaly_info.reported = true
                        record_anomaly_kill(anomaly_info.community, anomaly_info.rank, current_time)
                        report_anomaly_death(npc, anomaly_info)
                        mark_anomaly_death_spot(npc, anomaly_info)
                        tinsert(to_remove, npc_id)
                    end
                else
                    tinsert(to_remove, npc_id)
                end
            end
        end
    end

    for _, npc_id in ipairs(to_remove) do
        local st = npc_state[npc_id]
        if st then st.last_anomaly = nil end
    end
end


-- [ Level Check ]--

local function is_ignore_level()
    local current_level = level.name()
    if not current_level then return true end
    
    if not zz_priler_nda_location_settings then return false end
    local ignore_levels = zz_priler_nda_location_settings.nda_always_ignore_levels
    if not ignore_levels then return false end
    
    return ignore_levels[current_level] == true
end


-- [ Main Update Loop ]--

local function nda_periodic_tick()
    if not is_mod_enabled() then return end
    if surge_started() then return end
    if not db.actor then return end
    if is_ignore_level() then return end

    local current_time = time_global()

    check_anomaly_deaths(current_time)
    ensure_cache()

    -- Build the anomaly name->pos map once per tick; every NPC's memory bookkeeping reuses it.
    local cbn = {}
    for _, c in ipairs(anomaly_cache) do cbn[c.name] = c.pos end
    tick_cache_by_name = cbn

    -- Bubble gate (S2 inspired): when enabled, only NPCs within bubble_radius of the actor interact with
    -- anomalies (damage on per rules); those outside have anomaly damage forced off and their
    -- avoidance state cleared. When disabled, every online stalker is treated as inside.
    local bubble_enabled = get_mcm_setting("bubble_enabled", true)
    local bubble_radius = get_mcm_setting("bubble_radius", 150)
    local restrictions_ignore_radius = get_mcm_setting("restrictions_ignore_radius", true)
    local detection_radius = get_mcm_setting("base_detection_radius", 30)
    local actor_pos = get_position_copy(db.actor)
    
    if not actor_pos then return end

    -- Snapshot online stalker positions for the feeler election
    -- (is_feeler_elected). Rebuilt each tick so it reflects current positions.
    local snap = {}
    for _, sval in pairs(db.OnlineStalkers or {}) do
        local sobj = sval
        if type(sobj) == "number" then sobj = level.object_by_id(sobj) end
        if is_valid_stalker(sobj) then
            local p = get_position_copy(sobj)
            -- db.OnlineStalkers is an index-keyed array, so the table key is NOT the id;
            -- store the real object id or the id comparison in is_feeler_elected breaks.
            if p then snap[#snap + 1] = { id = safe_call(sobj.id, sobj), pos = p } end
        end
    end
    tick_npc_positions = snap

    local processed = 0

    for id, npc in pairs(db.OnlineStalkers or {}) do
        if type(npc) == "number" then
            npc = level.object_by_id(npc)
        end
        
        if is_valid_stalker(npc) then
            local npc_pos = get_position_copy(npc)
            if npc_pos then
                local distance = npc_pos:distance_to(actor_pos)
                local within_radius = (not bubble_enabled) or (distance <= bubble_radius)
                
                if within_radius then
                    configure_npc_anomaly_interaction(npc)
                else
                    -- Outside the interaction bubble: hand the NPC back to engine defaults
                    reset_npc_anomaly_state(npc)
                end

                if within_radius or restrictions_ignore_radius then
                    update_npc_restrictions(npc, detection_radius)
                end

                processed = processed + 1
            end
        end
    end

    if processed > 0 then
        dbg_verbose("UPDATE", "Processed %d NPCs (cache: %d anomalies)",
            processed, #anomaly_cache)
    end

    local pushing = 0
    for _, st in pairs(npc_state) do
        if st.push_through then pushing = pushing + 1 end
    end
    dbg_log("HEARTBEAT", "tick processed=%d pushing=%d cache=%d", processed, pushing, #anomaly_cache)
end

local function schedule_next_tick()
    CreateTimeEvent("nda_periodic", "nda_tick", UPDATE_INTERVAL_SEC, function()
        local ok, err = pcall(nda_periodic_tick)
        if not ok then
            printf("[NDA][TICK_FAIL] %s", tostring(err))
        end
        ResetTimeEvent("nda_periodic", "nda_tick", UPDATE_INTERVAL_SEC)
        return false
    end)
end


-- [ Debug Map Markers ]--

function show_debug_anomaly_markers()
    if not db.actor then return end
    
    ensure_cache()
    
    local count = 0
    for _, anom in ipairs(anomaly_cache) do
        local id = anom.id
        if level.map_has_object_spot(id, "anomaly_disabled") ~= 0 then
            level.map_remove_object_spot(id, "anomaly_disabled")
        end
        local marker_text = sformat("NDA: %s\\n%s", anom.name, anom.section)
        level.map_add_object_spot_ser(id, "anomaly_disabled", marker_text)
        count = count + 1
    end
    
    debug_anomalies_shown = true
    dbg_log("DEBUG", "Showing %d anomaly markers on map", count)
end

function hide_debug_anomaly_markers()
    local count = 0
    
    if cache_valid and #anomaly_cache > 0 then
        for _, anom in ipairs(anomaly_cache) do
            if level.map_has_object_spot(anom.id, "anomaly_disabled") ~= 0 then
                level.map_remove_object_spot(anom.id, "anomaly_disabled")
                count = count + 1
            end
        end
    else
        -- fallback scan
        for i = 1, 100000 do
            if level.map_has_object_spot(i, "anomaly_disabled") ~= 0 then
                level.map_remove_object_spot(i, "anomaly_disabled")
                count = count + 1
            end
        end
    end
    
    debug_anomalies_shown = false
    if count > 0 then
        dbg_log("DEBUG", "Removed %d anomaly markers from map", count)
    end
end

local function cleanup_old_map_markers()
    dbg_log("CLEANUP", "Manual cleanup requested, scanning all IDs...")
    local count = 0
    for i = 1, 100000 do
        if level.map_has_object_spot(i, "anomaly_disabled") ~= 0 then
            level.map_remove_object_spot(i, "anomaly_disabled")
            count = count + 1
        end
        if level.map_has_object_spot(i, DEATH_SPOT_TYPE) ~= 0 then
            level.map_remove_object_spot(i, DEATH_SPOT_TYPE)
            count = count + 1
        end
    end
    if count > 0 then
        dbg_log("CLEANUP", "Cleaned up %d map markers", count)
    else
        dbg_log("CLEANUP", "No markers found to clean up")
    end
    return count
end


-- [ Public API ]--

function invalidate_anomaly_cache()
    invalidate_cache()
    dbg_log("CACHE", "Cache invalidated by external call")
end

function rebuild_anomaly_cache_now()
    invalidate_cache()
    rebuild_anomaly_cache()
end

-- True if `pos` is within `radius` meters of any cached anomaly center.
function is_position_in_anomaly(pos, radius)
    if not pos then return false end
    radius = radius or 5
    ensure_cache()
    for _, anom in ipairs(anomaly_cache) do
        if anom.pos and pos:distance_to(anom.pos) <= radius then
            return true
        end
    end
    return false
end

-- True if NPC `id` is currently committed to sprinting through an anomaly field.
-- Used by loot_guard to suppress corpse-detection while the NPC is pushing out.
function is_npc_in_push_through(id)
    local st = id and npc_state[id]
    return st ~= nil and st.push_through == true
end


-- [ Event Callbacks ]--

local function schedule_cache_rebuild(reason)
    local delay = get_mcm_setting("cache_rebuild_delay", 2.5)
    dbg_verbose("EVENT", "%s, scheduling rebuild in %.1fs", reason, delay)
    
    RemoveTimeEvent("nda_cache_rebuild", "nda_cache_rebuild")
    
    if delay <= 0 then
        invalidate_cache()
        return
    end
    
    CreateTimeEvent("nda_cache_rebuild", "nda_cache_rebuild", delay, function()
        invalidate_cache()
        return true
    end)
end

local function on_actor_interaction(typ, obj, name)
    if typ ~= "anomalies" then return end
    
    if name == "emission_end" then
        schedule_cache_rebuild("Emission ended")
    elseif name == "psi_storm_end" then
        schedule_cache_rebuild("Psi-storm ended")
    end
end

local function on_game_load()
    dbg_verbose("EVENT", "Game loaded")

    safe_call(exec_console_cmd, "ai_die_in_anomaly 0")

    invalidate_cache()
    npc_state            = {}
    anomaly_protection_cache = {}
    pcall_failures_seen  = {}

    -- Drop the rolling kill-rate logs: they are in-memory only (time_global keeps running
    -- across a load), so without this a freshly loaded save would inherit up to a minute of
    -- kill stamps from whatever was playing before.
    kill_log_global      = {}
    kill_log_faction     = {}
    kill_log_rank        = {}

    -- Bootstrap (or re-arm) the periodic tick. RemoveTimeEvent first so a stale chain from
    -- a prior session/level doesn't double-fire alongside the new one.
    RemoveTimeEvent("nda_periodic", "nda_tick")
    schedule_next_tick()
end

local function on_level_changed()
    dbg_verbose("EVENT", "Level changed")
    invalidate_cache()
    npc_state            = {}
    pcall_failures_seen  = {}
    kill_log_global      = {}
    kill_log_faction     = {}
    kill_log_rank        = {}

    -- The actor_on_first_update hook will re-arm the timer on the new level via on_game_load.
    -- Drop the existing chain so it doesn't fire against a half-loaded level.
    RemoveTimeEvent("nda_periodic", "nda_tick")
end

local function on_npc_net_destroy(npc)
    local id
    if type(npc) == "number" then
        id = npc
    elseif is_valid_object(npc) then
        id = npc:id()
        
        local current = safe_call(npc.in_restrictions, npc) or ""
        if current ~= "" then
            safe_call(npc.remove_restrictions, npc, "", current)
        end
    else
        return
    end
    
    npc_state[id] = nil
end

local function on_npc_net_spawn(npc)
    if not is_mod_enabled() then return end
    if not is_valid_stalker(npc) then return end
    if is_ignore_level() then return end
    
    configure_npc_anomaly_interaction(npc)
end

local function on_option_change()
    local old_show_debug = cached_show_debug_anomalies
    local was_enabled = cached_mod_enabled
    update_mcm_cache()

    -- Mod just turned off: the tick stops managing NPCs, but the persistent engine flags
    -- NDA already set (anomaly pathfinding/damage) stay set, leaving touched NPCs routing
    -- around anomalies (stuck in corridors) with NDA no longer in control
    if was_enabled and not cached_mod_enabled then
        for _, npc in pairs(db.OnlineStalkers or {}) do
            if type(npc) == "number" then npc = level.object_by_id(npc) end
            if is_valid_stalker(npc) then reset_npc_anomaly_state(npc) end
        end
        dbg_log("INIT", "NDA disabled - reset anomaly flags on online stalkers")
    end

    -- The legacy-ignores toggle changes which anomalies are skipped; drop the memoized
    -- ignore lists and the anomaly cache so the next rebuild reflects the new setting.
    ignored_anomalies_hash = nil
    ignored_anomalies_patterns = nil
    invalidate_cache()

    if get_mcm_setting("cleanup_map_markers", false) then
        cleanup_old_map_markers()
    end
    
    if cached_show_debug_anomalies ~= old_show_debug then
        if cached_show_debug_anomalies then
            show_debug_anomaly_markers()
        else
            hide_debug_anomaly_markers()
        end
    end
end


-- [ Init ]--

function on_game_start()
    update_mcm_cache()

    RegisterScriptCallback("on_option_change", on_option_change)
    RegisterScriptCallback("npc_on_net_destroy", on_npc_net_destroy)
    RegisterScriptCallback("npc_on_net_spawn", on_npc_net_spawn)
    RegisterScriptCallback("anomaly_on_before_activate", on_anomaly_before_activate)
    RegisterScriptCallback("npc_on_before_hit", on_npc_before_hit)
    RegisterScriptCallback("actor_on_interaction", on_actor_interaction)
    RegisterScriptCallback("on_game_load", on_game_load)
    RegisterScriptCallback("actor_on_first_update", on_game_load)
    RegisterScriptCallback("on_level_changing", on_level_changed)
    
    -- Zone-disable handling is engine-based (is_enabled_anomaly)
    dbg_log("INIT", "NDA v3.0 loaded - enabled=%s, debug=%s",
        tostring(cached_mod_enabled), tostring(cached_debug_mode))
end
